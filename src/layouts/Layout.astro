const currentFaqItems = faqSchemaMap[locale] || faqSchemaMap.en;

// Comprehensive Multi-Node Schema.org Graph for Google Rich Results
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://forgeenergy.github.io/#website',
      url: 'https://forgeenergy.github.io/',
      name: 'ForgeEnergy',
      description: '100% Client-Side Energy Transmutation & Deep Work Vault',
      inLanguage: ['en', 'es', 'fr', 'pt', 'ja'],
      publisher: {
        '@type': 'Person',
        name: 'Kishara Dilz',
        url: 'https://buymeacoffee.com/kisharadilz',
      },
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://forgeenergy.github.io/#webapp',
      name: 'ForgeEnergy',
      url: 'https://forgeenergy.github.io/',
      inLanguage: ['en', 'es', 'fr', 'pt', 'ja'],
      applicationCategory: 'HealthApplication, ProductivityApplication',
      operatingSystem: 'All Modern Web Browsers',
      browserRequirements: 'Requires JavaScript and LocalStorage support',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description:
        'A 100% client-side sexual transmutation tool online, urge surfing app free, private focus streak tracker, and dopamine detox suite. Practice urge surfing with zero server data collection.',
      keywords: [
        'sexual transmutation tool online',
        'urge surfing app free',
        'private focus streak tracker',
        'client side habit tracker',
        'box breathing visualizer',
        'deep work vault',
        'dopamine detox tool',
        'neurochemical habit tracker',
      ],
      screenshot: 'https://forgeenergy.github.io/og-image.png',
      author: {
        '@type': 'Person',
        name: 'Kishara Dilz',
        url: 'https://buymeacoffee.com/kisharadilz',
      },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://forgeenergy.github.io/#software',
      name: 'ForgeEnergy Vault',
      applicationCategory: 'Productivity',
      operatingSystem: 'Any (Web Browser)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      featureList: [
        'Tactical 2-minute box breathing visualizer (Navy SEAL method)',
        '15-minute deep work sprint timer with Web Audio API harmonic chimes',
        'Client-side LocalStorage habit and streak tracker',
        'Real-world output ledger for code, reading, and physical PRs',
        'One-click AES-GCM 256-bit encrypted backup and restore',
        'Instant panic/stealth mode triggered by Escape key',
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: currentFaqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
    {
      '@type': 'HowTo',
      '@id': `${canonicalUrl}#howto`,
      name: 'How to Transmute Compulsive Urges into Deep Work Focus',
      description: 'A 3-step evidence-based protocol to intercept dopamine cravings and channel energy into creative output.',
      step: [
        {
          '@type': 'HowToStep',
          name: 'Somatic Interception (2-Minute Tactical Box Breathing)',
          text: 'Engage in Navy SEAL 4-4-4-4 box breathing to stimulate the vagus nerve, rapidly lowering sympathetic nervous excitation and breaking the impulse loop.',
        },
        {
          '@type': 'HowToStep',
          name: 'Cognitive Reframing (Urge Surfing Protocol)',
          text: 'Observe bodily sensations without judgment. Recognize that cravings peak within 2-3 minutes and dissolve like ocean waves.',
        },
        {
          '@type': 'HowToStep',
          name: 'Creative Anchoring (15-Minute Flow State Sprint)',
          text: 'Channel the mobilized physiological power directly into writing code, reading, or creating tangible output, logging the result in your Energy Ledger.',
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'ForgeEnergy',
          item: 'https://forgeenergy.github.io/',
        },
        ...(locale !== 'en'
          ? [
              {
                '@type': 'ListItem',
                position: 2,
                name: locale.toUpperCase(),
                item: canonicalUrl,
              },
            ]
          : []),
      ],
    },
  ],
};
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon & PWA App Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- International hreflang Alternate Links for Global Search Engines -->
    <link rel="alternate" hreflang="en" href={alternateUrls.en} />
    <link rel="alternate" hreflang="es" href={alternateUrls.es} />
    <link rel="alternate" hreflang="fr" href={alternateUrls.fr} />
    <link rel="alternate" hreflang="pt" href={alternateUrls.pt} />
    <link rel="alternate" hreflang="ja" href={alternateUrls.ja} />
    <link rel="alternate" hreflang="x-default" href={alternateUrls.en} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="sexual transmutation tool online, urge surfing app free, private focus streak tracker, client side habit tracker, dopamine detox tool, box breathing visualizer, deep work timer, zero server productivity"
    />
    <meta name="author" content="Kishara Dilz" />
    <link rel="author" href="https://buymeacoffee.com/kisharadilz" />

    <!-- Search Engine Indexing & Bot Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Theme Colors -->
    <meta name="theme-color" content="#F7F2EB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0F0D" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Facebook / Discord / Slack Rich Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ForgeEnergy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://forgeenergy.github.io/og-image.png" />
    <meta property="og:image:secure_url" content="https://forgeenergy.github.io/og-image.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ForgeEnergy - 100% Client-Side Energy Transmutation & Deep Work Vault" />
    <meta property="og:locale" content={localeToOgLocale[locale] || 'en_US'} />

    <!-- Twitter Summary Card with Large Image -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://forgeenergy.github.io/og-image.png" />
    <meta name="twitter:image:alt" content="ForgeEnergy Vault Interface and Box Breathing Guide" />

    <!-- Schema.org JSON-LD Structured Data Injection -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Theme Initialization Script (Avoids Flash of Unstyled Theme) -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('forge_theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-[#F7F2EB] dark:bg-[#0E0F0D] text-[#22241F] dark:text-[#EFECE6] min-h-screen">
    <slot />
  </body>
</html>
